{
  "manifest_version": 3,
  "name": "GCP Spotlight",
  "version": "0.1.0",
  "description": "Search Google Cloud console pages with a keyboard shortcut and jump straight to them.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://console.cloud.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://console.cloud.google.com/*"],
      "js": ["header.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "GCP Spotlight",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "options_page": "options.html",
  "commands": {
    "open-spotlight": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open GCP Spotlight"
    }
  }
}
